<Window x:Class="DouyinDesktop.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="780" Height="600"
        MinWidth="640" MinHeight="480"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBrush}"
        ShowInTaskbar="False"
        InputMethod.IsInputMethodEnabled="False"
        PreviewKeyDown="OnPreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Height="40" Background="{StaticResource BgBrush}"
              MouseLeftButtonDown="OnTitleDrag">
            <TextBlock Text="设置" Margin="18,0,0,0" VerticalAlignment="Center"
                       FontSize="12" Foreground="{StaticResource SubTextBrush}" />
            <Button Content="✕" Style="{StaticResource CloseButton}"
                    HorizontalAlignment="Right" Click="OnCloseClick" />
            <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource LineBrush}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="172" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border Grid.Column="0" Background="#0E0E13"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,14,0,0">
                    <Button x:Name="NavAccount" Content="账号" Tag="active"
                            Style="{StaticResource NavButton}" Click="OnNavAccount" />
                    <Button x:Name="NavKeys" Content="快捷键"
                            Style="{StaticResource NavButton}" Click="OnNavKeys" />
                    <Button x:Name="NavPlay" Content="播放"
                            Style="{StaticResource NavButton}" Click="OnNavPlay" />
                    <Button x:Name="NavAbout" Content="关于"
                            Style="{StaticResource NavButton}" Click="OnNavAbout" />
                </StackPanel>
            </Border>

            <!-- 账号页 -->
            <Grid x:Name="PageAccount" Grid.Column="1">
                <StackPanel Margin="28,26,28,24">
                    <TextBlock Text="账号" FontSize="15" FontWeight="SemiBold" />

                    <Border Background="#17171E" CornerRadius="8" Padding="18,16" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="AccountStatus" Text="未登录" FontSize="14" />
                                <TextBlock x:Name="AccountHint" FontSize="11"
                                           Foreground="#5A5A66" Margin="0,5,0,0"
                                           Text="登录后可看到个性化推荐、完整评论" />
                                <TextBlock x:Name="HealthText" FontSize="11"
                                           Foreground="#5A5A66" Margin="0,4,0,0"
                                           Text="登录状态：加载视频后自动检查" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button x:Name="LoginBtn" Content="扫码登录"
                                        Style="{StaticResource LinkButton}" Click="OnLoginClick" />
                                <Button x:Name="LogoutBtn" Content="退出登录"
                                        Style="{StaticResource LinkButton}" Margin="20,0,0,0"
                                        Click="OnLogoutClick" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 快捷键页 -->
            <Grid x:Name="PageKeys" Grid.Column="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="快捷键" Margin="28,26,28,12"
                           FontSize="15" FontWeight="SemiBold" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="KeyList" Margin="28,0,28,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#1F1F28" BorderThickness="0,0,0,1">
                                    <Grid Height="48">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="112" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontSize="13" />
                                            <TextBlock Text="{Binding AliasText}" FontSize="11"
                                                       Foreground="#5A5A66" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding KeyText}"
                                                   VerticalAlignment="Center" FontSize="13"
                                                   Foreground="#C8C8D2" />

                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Content="修改" Tag="{Binding}"
                                                    Style="{StaticResource LinkButton}"
                                                    Click="OnRebindClick" />
                                            <Button Content="清除" Tag="{Binding}"
                                                    Style="{StaticResource LinkButton}"
                                                    Margin="14,0,0,0" Click="OnClearClick" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="0,1,0,0" Padding="28,12">
                    <DockPanel>
                        <Button Content="恢复默认" Style="{StaticResource LinkButton}"
                                VerticalAlignment="Center" Click="OnResetClick" />
                        <TextBlock x:Name="HintText" Text="" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" FontSize="12"
                                   Foreground="#7A8AA8" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- 播放页 -->
            <Grid x:Name="PagePlay" Grid.Column="1" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,26,28,24">
                    <TextBlock Text="播放" FontSize="15" FontWeight="SemiBold" />

                    <Border Background="#17171E" CornerRadius="8" Padding="18,16" Margin="0,14,0,0">
                        <StackPanel>
                            <CheckBox x:Name="ImageOnlyCheck" Content="只看图集（跳过视频）"
                                      Foreground="{StaticResource TextBrush}" FontSize="13"
                                      Checked="OnImageOnlyChanged" Unchecked="OnImageOnlyChanged" />
                            <TextBlock FontSize="11" Foreground="#5A5A66" Margin="0,9,0,0"
                                       TextWrapping="Wrap" LineHeight="18"
                                       Text="⚠ 2026-10-25 实测：推荐流连续 80 条里图集为 0，这个开关目前大概率拉不到内容。要看图集请按 Tab 切到「主页」，从作者作品里找。" />
                        </StackPanel>
                    </Border>

                    <Border Background="#17171E" CornerRadius="8" Padding="18,16" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="内容偏好（按标签过滤）" Foreground="{StaticResource TextBrush}" FontSize="13" />
                            <TextBlock FontSize="11" Foreground="#5A5A66" Margin="0,9,0,0"
                                       TextWrapping="Wrap" LineHeight="18"
                                       Text="一行一条。不带前缀 = 只看这类；- 前缀 = 屏蔽这类。&#10;匹配是包含关系（“短剧”能命中“热播短剧”）。留空不过滤。&#10;例：  助眠     /     -短剧" />
                            <TextBox x:Name="TagRulesBox" Margin="0,10,0,0" Height="88"
                                     Background="#101016" Foreground="{StaticResource TextBrush}"
                                     BorderBrush="#2A2A34" CaretBrush="{StaticResource TextBrush}"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     FontSize="12" Padding="8,6"
                                     TextChanged="OnTagRulesChanged" />
                            <TextBlock x:Name="TagRulesHint" FontSize="11" Foreground="#5A5A66" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="#17171E" CornerRadius="8" Padding="18,16" Margin="0,12,0,0">
                        <StackPanel>
                            <CheckBox x:Name="DanmakuCheck" Content="显示弹幕"
                                      Foreground="{StaticResource TextBrush}" FontSize="13"
                                      Checked="OnDanmakuChanged" Unchecked="OnDanmakuChanged" />

                            <!-- 勾上才可调 -->
                            <StackPanel x:Name="DanmakuOptions" Margin="0,16,0,0" IsEnabled="False">

                                <!-- 显示区域 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="显示区域" FontSize="12" Foreground="#8C8C99"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="AreaTop" Content="顶部" CommandParameter="top"
                                                Style="{StaticResource SegButton}" Click="OnDanmakuAreaClick" />
                                        <Button x:Name="AreaMiddle" Content="中间" CommandParameter="middle"
                                                Style="{StaticResource SegButton}" Click="OnDanmakuAreaClick" />
                                        <Button x:Name="AreaBottom" Content="底部" CommandParameter="bottom"
                                                Style="{StaticResource SegButton}" Click="OnDanmakuAreaClick" />
                                        <Button x:Name="AreaFull" Content="全屏" CommandParameter="full"
                                                Style="{StaticResource SegButton}" Click="OnDanmakuAreaClick" />
                                    </StackPanel>
                                </Grid>

                                <!-- 字号 -->
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="字号" FontSize="12" Foreground="#8C8C99"
                                               VerticalAlignment="Center" />
                                    <Slider x:Name="FontSlider" Grid.Column="1" Minimum="1" Maximum="6"
                                            TickFrequency="0.1" IsSnapToTickEnabled="True"
                                            Style="{StaticResource DarkSlider}"
                                            ValueChanged="OnDanmakuStyleChanged" />
                                    <TextBlock x:Name="FontValue" Grid.Column="2" FontSize="12"
                                               Foreground="{StaticResource TextBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <!-- 不透明度 -->
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="不透明度" FontSize="12" Foreground="#8C8C99"
                                               VerticalAlignment="Center" />
                                    <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="10" Maximum="100"
                                            TickFrequency="5" IsSnapToTickEnabled="True"
                                            Style="{StaticResource DarkSlider}"
                                            ValueChanged="OnDanmakuStyleChanged" />
                                    <TextBlock x:Name="OpacityValue" Grid.Column="2" FontSize="12"
                                               Foreground="{StaticResource TextBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <!-- 描边 -->
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="描边" FontSize="12" Foreground="#8C8C99"
                                               VerticalAlignment="Center" />
                                    <Slider x:Name="OutlineSlider" Grid.Column="1" Minimum="0" Maximum="30"
                                            TickFrequency="1" IsSnapToTickEnabled="True"
                                            Style="{StaticResource DarkSlider}"
                                            ValueChanged="OnDanmakuStyleChanged" />
                                    <TextBlock x:Name="OutlineValue" Grid.Column="2" FontSize="12"
                                               Foreground="{StaticResource TextBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <!-- 速度 -->
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="移动速度" FontSize="12" Foreground="#8C8C99"
                                               VerticalAlignment="Center" />
                                    <Slider x:Name="SpeedSlider" Grid.Column="1" Minimum="4" Maximum="20"
                                            TickFrequency="0.5" IsSnapToTickEnabled="True"
                                            Style="{StaticResource DarkSlider}"
                                            ValueChanged="OnDanmakuStyleChanged" />
                                    <TextBlock x:Name="SpeedValue" Grid.Column="2" FontSize="12"
                                               Foreground="{StaticResource TextBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock FontSize="11" Foreground="#5A5A66" Margin="0,14,0,0"
                                           TextWrapping="Wrap" LineHeight="18"
                                           Text="只有创作者开启了弹幕的作品才有。弹幕由播放器渲染成字幕轨（视频是独立窗口，界面层盖不上去），所以外观只能是白字黑边、从右往左滚。" />

                                <!-- 渲染方式：默认字幕轨（稳），浮层是实验性的 -->
                                <CheckBox x:Name="OverlayCheck" Margin="0,12,0,0"
                                          Content="用浮层渲染（更顺滑，实验性）"
                                          Foreground="{StaticResource TextBrush}" FontSize="12"
                                          Checked="OnOverlayRendererChanged" Unchecked="OnOverlayRendererChanged" />
                                <TextBlock FontSize="11" Foreground="#5A5A66" Margin="0,6,0,0"
                                           TextWrapping="Wrap" LineHeight="18"
                                           Text="默认用字幕轨，稳定。浮层是按显示器刷新率单独画的，弹幕移动更顺，但窗口层级相关的 bug 多（全屏/设置对话框/多屏），遇到问题就关掉这个。" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 关于页 -->
            <Grid x:Name="PageAbout" Grid.Column="1" Visibility="Collapsed">
                <StackPanel Margin="28,26,28,24">
                    <TextBlock Text="关于" FontSize="15" FontWeight="SemiBold" />

                    <TextBlock Text="抖音桌面版" FontSize="14" Margin="0,16,0,0" />
                    <TextBlock Text="原生接口 + mpv 播放，不加载网页" FontSize="11"
                               Foreground="#5A5A66" Margin="0,5,0,0" />

                    <TextBlock Text="数据目录" FontSize="12" Foreground="{StaticResource SubTextBrush}"
                               Margin="0,22,0,6" />
                    <TextBlock x:Name="DataPathText" FontSize="11" Foreground="#9A9AA6"
                               TextWrapping="Wrap" />
                    <Button Content="打开数据目录" Style="{StaticResource LinkButton}"
                            Margin="0,10,0,0" Click="OnOpenDataDir" />

                    <TextBlock Text="源码" FontSize="12" Foreground="{StaticResource SubTextBrush}"
                               Margin="0,22,0,6" />
                    <TextBlock Text="https://github.com/yhgeo/douyin-desktop-v2"
                               FontSize="11" Foreground="#7A9AC8" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
