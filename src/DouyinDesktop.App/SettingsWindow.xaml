<Window x:Class="DouyinDesktop.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="780" Height="600"
        MinWidth="640" MinHeight="480"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBrush}"
        ShowInTaskbar="False"
        InputMethod.IsInputMethodEnabled="False"
        PreviewKeyDown="OnPreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Height="40" Background="{StaticResource BgBrush}"
              MouseLeftButtonDown="OnTitleDrag">
            <TextBlock Text="设置" Margin="18,0,0,0" VerticalAlignment="Center"
                       FontSize="12" Foreground="{StaticResource SubTextBrush}" />
            <Button Content="✕" Style="{StaticResource CloseButton}"
                    HorizontalAlignment="Right" Click="OnCloseClick" />
            <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource LineBrush}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="172" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border Grid.Column="0" Background="#0E0E13"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,14,0,0">
                    <Button x:Name="NavAccount" Content="账号" Tag="active"
                            Style="{StaticResource NavButton}" Click="OnNavAccount" />
                    <Button x:Name="NavContent" Content="内容偏好"
                            Style="{StaticResource NavButton}" Click="OnNavContent" />
                    <Button x:Name="NavTaste" Content="推荐倾向"
                            Style="{StaticResource NavButton}" Click="OnNavTaste" />
                    <Button x:Name="NavDanmaku" Content="弹幕"
                            Style="{StaticResource NavButton}" Click="OnNavDanmaku" />
                    <Button x:Name="NavKeys" Content="快捷键"
                            Style="{StaticResource NavButton}" Click="OnNavKeys" />
                    <Button x:Name="NavBackup" Content="备份"
                            Style="{StaticResource NavButton}" Click="OnNavBackup" />
                    <Button x:Name="NavAbout" Content="关于"
                            Style="{StaticResource NavButton}" Click="OnNavAbout" />
                </StackPanel>
            </Border>

            <!-- 账号页 -->
            <Grid x:Name="PageAccount" Grid.Column="1">
                <StackPanel Margin="28,26,28,24">
                    <TextBlock Text="账号" FontSize="15" FontWeight="SemiBold" />

                    <Border Background="#17171E" CornerRadius="8" Padding="18,16" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="AccountStatus" Text="未登录" FontSize="14" />
                                <TextBlock x:Name="AccountHint" FontSize="11"
                                           Foreground="#5A5A66" Margin="0,5,0,0"
                                           Text="登录后可看到个性化推荐、完整评论" />
                                <TextBlock x:Name="HealthText" FontSize="11"
                                           Foreground="#5A5A66" Margin="0,4,0,0"
                                           Text="登录状态：加载视频后自动检查" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button x:Name="LoginBtn" Content="扫码登录"
                                        Style="{StaticResource LinkButton}" Click="OnLoginClick" />
                                <Button x:Name="LogoutBtn" Content="退出登录"
                                        Style="{StaticResource LinkButton}" Margin="20,0,0,0"
                                        Click="OnLogoutClick" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 快捷键页 -->
            <Grid x:Name="PageKeys" Grid.Column="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="快捷键" Margin="28,26,28,12"
                           FontSize="15" FontWeight="SemiBold" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="KeyList" Margin="28,0,28,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#1F1F28" BorderThickness="0,0,0,1">
                                    <Grid Height="48">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="112" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontSize="13" />
                                            <TextBlock Text="{Binding AliasText}" FontSize="11"
                                                       Foreground="#5A5A66" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding KeyText}"
                                                   VerticalAlignment="Center" FontSize="13"
                                                   Foreground="#C8C8D2" />

                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Content="修改" Tag="{Binding}"
                                                    Style="{StaticResource LinkButton}"
                                                    Click="OnRebindClick" />
                                            <Button Content="清除" Tag="{Binding}"
                                                    Style="{StaticResource LinkButton}"
                                                    Margin="14,0,0,0" Click="OnClearClick" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="0,1,0,0" Padding="28,12">
                    <DockPanel>
                        <Button Content="恢复默认" Style="{StaticResource LinkButton}"
                                VerticalAlignment="Center" Click="OnResetClick" />
                        <TextBlock x:Name="HintText" Text="" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" FontSize="12"
                                   Foreground="#7A8AA8" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- 推荐倾向页 -->
            <Grid x:Name="PageTaste" Grid.Column="1" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,26,28,24">
                        <TextBlock Text="推荐倾向" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock FontSize="11" Foreground="#5A5A66" Margin="0,8,0,0"
                                   TextWrapping="Wrap" LineHeight="18"
                                   Text="逐条读取平台标签（抖音三级分类，如「美食 → 美食探店 → 餐厅探店」），看平台正在推什么。每条约 0.6 秒。" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="TasteRunBtn" Content="开始分析" Padding="16,6" FontSize="12"
                                    Cursor="Hand" BorderThickness="0"
                                    Background="#FE2C55" Foreground="White"
                                    Click="OnRunTaste" />
                            <TextBlock x:Name="TasteStatus" VerticalAlignment="Center" Margin="14,0,0,0"
                                       FontSize="11" Foreground="#7A8AA8" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- 采样数量：平台标签要逐条取详情，条数直接决定等多久 -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="采样数量" FontSize="11" Foreground="#5A5A66"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button x:Name="TasteCount20" Content="20 条" CommandParameter="20"
                                    Style="{StaticResource SegButton}" Click="OnTasteCountClick" />
                            <Button x:Name="TasteCount40" Content="40 条" CommandParameter="40"
                                    Style="{StaticResource SegButton}" Click="OnTasteCountClick" />
                            <Button x:Name="TasteCount60" Content="60 条" CommandParameter="60"
                                    Style="{StaticResource SegButton}" Click="OnTasteCountClick" />
                            <Button x:Name="TasteCount100" Content="100 条" CommandParameter="100"
                                    Style="{StaticResource SegButton}" Click="OnTasteCountClick" />
                            <TextBlock x:Name="TasteCountHint" FontSize="11" Foreground="#5A5A66"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>

                        <Border x:Name="TasteResult" Visibility="Collapsed"
                                Background="#17171E" CornerRadius="8" Padding="18,16" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock x:Name="TasteSummary" FontSize="13" TextWrapping="Wrap"
                                           LineHeight="20" Foreground="{StaticResource TextBrush}" />
                                <TextBlock x:Name="TasteMeta" FontSize="11" Foreground="#5A5A66"
                                           Margin="0,8,0,0" TextWrapping="Wrap" />

                                <TextBlock Text="主题分布" FontSize="12" Foreground="#8C8C99"
                                           Margin="0,18,0,8" />
                                <StackPanel x:Name="TasteThemes" />

                                <TextBlock Text="高频标签" FontSize="12" Foreground="#8C8C99"
                                           Margin="0,18,0,8" />
                                <WrapPanel x:Name="TasteTags" />

                                <TextBlock Text="作者集中度" FontSize="12" Foreground="#8C8C99"
                                           Margin="0,18,0,8" />
                                <StackPanel x:Name="TasteAuthors" />

                                <TextBlock FontSize="11" Foreground="#5A5A66" Margin="0,16,0,0"
                                           TextWrapping="Wrap" LineHeight="18"
                                           Text="多跑几次更稳。单个账号占三成以上时，说明这一屏被刷屏了，不代表整体倾向。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 备份页 -->
            <Grid x:Name="PageBackup" Grid.Column="1" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,26,28,24">
                        <TextBlock Text="备份" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="BackupLast" FontSize="11" Foreground="#5A5A66"
                                   Margin="0,7,0,0" TextWrapping="Wrap"
                                   Text="还没有备份过" />

                        <Border Background="#17171E" CornerRadius="8" Padding="18,16" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="为什么不用下载视频" FontSize="13"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock FontSize="11" Foreground="#5A5A66" Margin="0,8,0,0"
                                           TextWrapping="Wrap" LineHeight="19"
                                           Text="视频几十上百 MB，几百条就是几十 GB。备份只存「作品 ID」和「视频 ID」——永久标识，以后用它们重取播放地址即可（几毫秒）。网页链接同样永久，除非作者删了作品。" />
                            </StackPanel>
                        </Border>

                        <Border Background="#17171E" CornerRadius="8" Padding="18,16" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="会存下来的内容" FontSize="13"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock FontSize="11" Foreground="#5A5A66" Margin="0,8,0,0"
                                           TextWrapping="Wrap" LineHeight="19"
                                           Text="ID、链接、文案、发布时间、作者、互动数据、时长分辨率、封面、标签、音乐" />
                                <TextBlock FontSize="11" Foreground="#5A5A66" Margin="0,6,0,0"
                                           TextWrapping="Wrap" LineHeight="19"
                                           Text="⚠ 抖音不返回「收藏时间」，只能按接口顺序（大致从新到旧）排列。" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="BackupRunBtn" Content="备份我的收藏" Padding="16,6" FontSize="12"
                                    Cursor="Hand" BorderThickness="0"
                                    Background="#FE2C55" Foreground="White"
                                    Click="OnRunBackup" />
                            <TextBlock x:Name="BackupStatus" VerticalAlignment="Center" Margin="14,0,0,0"
                                       FontSize="11" Foreground="#7A8AA8" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border x:Name="BackupResult" Visibility="Collapsed"
                                Background="#17171E" CornerRadius="8" Padding="18,16" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock x:Name="BackupSummary" FontSize="13" TextWrapping="Wrap"
                                           LineHeight="20" Foreground="{StaticResource TextBrush}" />
                                <TextBlock x:Name="BackupPath" FontSize="11" Foreground="#5A5A66"
                                           Margin="0,8,0,0" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="打开备份目录" Style="{StaticResource LinkButton}"
                                            Click="OnOpenBackupDir" />
                                    <Button Content="打开卡片墙" Style="{StaticResource LinkButton}"
                                            Margin="18,0,0,0" Click="OnOpenBackupHtml" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 内容偏好页 -->
            <Grid x:Name="PageContent" Grid.Column="1" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,26,28,24">
                        <TextBlock Text="内容偏好" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock FontSize="11" Foreground="#5A5A66" Margin="0,7,0,0"
                                   TextWrapping="Wrap" LineHeight="18"
                                   Text="按话题标签筛选推荐流。点上面的分组切换；一行写一个标签：直接写 = 只看这类，- 开头 = 屏蔽这类。" />

                        <Border Background="#17171E" CornerRadius="8" Padding="18,16" Margin="0,14,0,0">
                            <StackPanel>
                                <WrapPanel x:Name="GroupTabs" Margin="0,0,0,2" />

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="组名" FontSize="11" Foreground="#5A5A66" VerticalAlignment="Center" />
                                    <TextBox x:Name="GroupNameBox" Width="128" Margin="8,0,0,0"
                                             Background="#101016" Foreground="{StaticResource TextBrush}"
                                             BorderBrush="#2A2A34" CaretBrush="{StaticResource TextBrush}"
                                             FontSize="12" Padding="6,4"
                                             TextChanged="OnGroupNameChanged" />
                                    <Button Content="＋ 新建" Margin="10,0,0,0" Padding="10,4" FontSize="11"
                                            Cursor="Hand" BorderThickness="0"
                                            Background="#22222C" Foreground="#C8C8D2"
                                            Click="OnAddGroup" />
                                    <Button Content="删除" Margin="8,0,0,0" Padding="10,4" FontSize="11"
                                            Cursor="Hand" BorderThickness="0"
                                            Background="#22222C" Foreground="#8A8A96"
                                            Click="OnDeleteGroup" />
                                </StackPanel>

                                <TextBox x:Name="GroupRulesBox" Margin="0,10,0,0" Height="150"
                                         Background="#101016" Foreground="{StaticResource TextBrush}"
                                         BorderBrush="#2A2A34" CaretBrush="{StaticResource TextBrush}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         FontSize="12" Padding="8,6"
                                         FontFamily="Consolas, Microsoft YaHei"
                                         TextChanged="OnGroupRulesChanged" />
                                <TextBlock x:Name="GroupHint" FontSize="11" Foreground="#5A5A66" Margin="0,8,0,0"
                                           TextWrapping="Wrap" LineHeight="18" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 弹幕页 -->
            <Grid x:Name="PageDanmaku" Grid.Column="1" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,26,28,24">
                        <TextBlock Text="弹幕" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock FontSize="11" Foreground="#5A5A66" Margin="0,7,0,0"
                                   TextWrapping="Wrap" LineHeight="18"
                                   Text="只有创作者开了弹幕的作品才有。" />

                        <Border Background="#17171E" CornerRadius="8" Padding="18,16" Margin="0,14,0,0">
                            <StackPanel>
                                <CheckBox x:Name="DanmakuCheck" Content="显示弹幕"
                                          Foreground="{StaticResource TextBrush}" FontSize="13"
                                          Checked="OnDanmakuChanged" Unchecked="OnDanmakuChanged" />

                                <StackPanel x:Name="DanmakuOptions" Margin="0,16,0,0" IsEnabled="False">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="显示区域" FontSize="12" Foreground="#8C8C99"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button x:Name="AreaTop" Content="顶部" CommandParameter="top"
                                                    Style="{StaticResource SegButton}" Click="OnDanmakuAreaClick" />
                                            <Button x:Name="AreaMiddle" Content="中间" CommandParameter="middle"
                                                    Style="{StaticResource SegButton}" Click="OnDanmakuAreaClick" />
                                            <Button x:Name="AreaBottom" Content="底部" CommandParameter="bottom"
                                                    Style="{StaticResource SegButton}" Click="OnDanmakuAreaClick" />
                                            <Button x:Name="AreaFull" Content="全屏" CommandParameter="full"
                                                    Style="{StaticResource SegButton}" Click="OnDanmakuAreaClick" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="字号" FontSize="12" Foreground="#8C8C99"
                                                   VerticalAlignment="Center" />
                                        <Slider x:Name="FontSlider" Grid.Column="1" Minimum="1" Maximum="6"
                                                TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                Style="{StaticResource DarkSlider}"
                                                ValueChanged="OnDanmakuStyleChanged" />
                                        <TextBlock x:Name="FontValue" Grid.Column="2" FontSize="12"
                                                   Foreground="{StaticResource TextBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="不透明度" FontSize="12" Foreground="#8C8C99"
                                                   VerticalAlignment="Center" />
                                        <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="10" Maximum="100"
                                                TickFrequency="5" IsSnapToTickEnabled="True"
                                                Style="{StaticResource DarkSlider}"
                                                ValueChanged="OnDanmakuStyleChanged" />
                                        <TextBlock x:Name="OpacityValue" Grid.Column="2" FontSize="12"
                                                   Foreground="{StaticResource TextBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="描边" FontSize="12" Foreground="#8C8C99"
                                                   VerticalAlignment="Center" />
                                        <Slider x:Name="OutlineSlider" Grid.Column="1" Minimum="0" Maximum="30"
                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                Style="{StaticResource DarkSlider}"
                                                ValueChanged="OnDanmakuStyleChanged" />
                                        <TextBlock x:Name="OutlineValue" Grid.Column="2" FontSize="12"
                                                   Foreground="{StaticResource TextBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="速度" FontSize="12" Foreground="#8C8C99"
                                                   VerticalAlignment="Center" />
                                        <Slider x:Name="SpeedSlider" Grid.Column="1" Minimum="4" Maximum="20"
                                                TickFrequency="0.5" IsSnapToTickEnabled="True"
                                                Style="{StaticResource DarkSlider}"
                                                ValueChanged="OnDanmakuStyleChanged" />
                                        <TextBlock x:Name="SpeedValue" Grid.Column="2" FontSize="12"
                                                   Foreground="{StaticResource TextBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#17171E" CornerRadius="8" Padding="18,16" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="渲染方式" FontSize="13" Foreground="{StaticResource TextBrush}" />
                                <TextBlock FontSize="11" Foreground="#5A5A66" Margin="0,7,0,0"
                                           TextWrapping="Wrap" LineHeight="18"
                                           Text="默认字幕轨，稳定。浮层更顺滑，但窗口层级相关的 bug 多（全屏、多屏、设置对话框），遇到问题就关掉。" />
                                <CheckBox x:Name="OverlayCheck" Margin="0,10,0,0"
                                          Content="用浮层渲染（实验性）"
                                          Foreground="{StaticResource TextBrush}" FontSize="12"
                                          Checked="OnOverlayRendererChanged" Unchecked="OnOverlayRendererChanged" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 关于页 -->
            <Grid x:Name="PageAbout" Grid.Column="1" Visibility="Collapsed">
                <StackPanel Margin="28,26,28,24">
                    <TextBlock Text="关于" FontSize="15" FontWeight="SemiBold" />

                    <TextBlock Text="抖音桌面版" FontSize="14" Margin="0,16,0,0" />
                    <TextBlock Text="原生接口 + mpv 播放，不加载网页" FontSize="11"
                               Foreground="#5A5A66" Margin="0,5,0,0" />

                    <TextBlock Text="数据目录" FontSize="12" Foreground="{StaticResource SubTextBrush}"
                               Margin="0,22,0,6" />
                    <TextBlock x:Name="DataPathText" FontSize="11" Foreground="#9A9AA6"
                               TextWrapping="Wrap" />
                    <Button Content="打开数据目录" Style="{StaticResource LinkButton}"
                            Margin="0,10,0,0" Click="OnOpenDataDir" />

                    <TextBlock Text="源码" FontSize="12" Foreground="{StaticResource SubTextBrush}"
                               Margin="0,22,0,6" />
                    <TextBlock Text="https://github.com/yhgeo/douyin-desktop-v2"
                               FontSize="11" Foreground="#7A9AC8" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
