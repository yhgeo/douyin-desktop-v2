<Window x:Class="DouyinDesktop.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="520" Height="660"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBrush}"
        ShowInTaskbar="False"
        InputMethod.IsInputMethodEnabled="False"
        PreviewKeyDown="OnPreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Height="40" Background="{StaticResource BgBrush}"
              MouseLeftButtonDown="OnTitleDrag">
            <TextBlock Text="设置" Margin="18,0,0,0" VerticalAlignment="Center"
                       FontSize="12" Foreground="{StaticResource SubTextBrush}" />
            <Button Content="✕" Style="{StaticResource CloseButton}"
                    HorizontalAlignment="Right" Click="OnCloseClick" />
            <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource LineBrush}" />
        </Grid>

        <!-- 账号 -->
        <StackPanel Grid.Row="1" Margin="24,18,24,10">
            <TextBlock Text="账号" FontSize="13" Foreground="{StaticResource SubTextBrush}" />
            <Grid Margin="0,10,0,0" Height="28">
                <TextBlock x:Name="AccountStatus" Text="未登录"
                           VerticalAlignment="Center" FontSize="13" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="LoginBtn" Content="扫码登录" Click="OnLoginClick"
                            Style="{StaticResource LinkButton}" />
                    <Button x:Name="LogoutBtn" Content="退出登录" Click="OnLogoutClick"
                            Style="{StaticResource LinkButton}" Margin="18,0,0,0" />
                </StackPanel>
            </Grid>
            <Border Height="1" Background="#1F1F28" Margin="0,12,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="2" Text="快捷键" Margin="24,10,24,8"
                   FontSize="13" Foreground="{StaticResource SubTextBrush}" />

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="KeyList" Margin="24,0,24,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#1F1F28" BorderThickness="0,0,0,1">
                            <Grid Height="46">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Label}" FontSize="13" />
                                    <TextBlock Text="{Binding AliasText}" FontSize="11"
                                               Foreground="#5A5A66" Margin="0,2,0,0" />
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding KeyText}"
                                           VerticalAlignment="Center" FontSize="13"
                                           Foreground="#C8C8D2" />

                                <Button Grid.Column="2" Content="修改" Tag="{Binding}"
                                        Style="{StaticResource LinkButton}"
                                        VerticalAlignment="Center" Click="OnRebindClick" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="4" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                Padding="24,14">
            <DockPanel>
                <Button Content="恢复默认" Style="{StaticResource LinkButton}"
                        VerticalAlignment="Center" Click="OnResetClick" />
                <TextBlock x:Name="HintText" Text="" DockPanel.Dock="Right"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="12" Foreground="#7A8AA8" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
