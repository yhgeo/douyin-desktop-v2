<Window x:Class="DouyinDesktop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DouyinDesktop.App"
        Title="抖音" Height="800" Width="1240"
        MinHeight="560" MinWidth="900"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        InputMethod.IsInputMethodEnabled="False"
        PreviewKeyDown="OnPreviewKeyDown"
        MouseWheel="OnMouseWheel"
        Loaded="OnLoaded"
        Closing="OnClosing"
        StateChanged="OnWindowStateChanged"
        SizeChanged="OnSizeChanged">

    <!--
        无边框窗口：WindowStyle 从头到尾都是 None。
        为什么不用默认边框 + 全屏时改 WindowStyle —— 那会让 WPF 重建 HWND，
        HwndHost 重建后 mpv 嵌在旧句柄上，画面就没了，只能重启播放器（约 300ms 黑屏）。
        这里把"边框"这件事交给 WindowChrome，全屏只是隐藏标题栏 + 最大化，句柄不动。
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏 -->
        <Grid x:Name="TitleBar" Grid.Row="0" Height="38" Background="{StaticResource BgBrush}">
            <TextBlock Text="抖音" Margin="16,0,0,0" VerticalAlignment="Center"
                       FontSize="12" Foreground="{StaticResource SubTextBrush}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="LoginButton" Content="登录" Width="64" Height="38"
                        Style="{StaticResource CaptionButton}"
                        FontFamily="Microsoft YaHei UI" FontSize="12"
                        ToolTip="扫码登录（L）"
                        Click="OnLoginClick" />

                <Button Style="{StaticResource CaptionButton}" ToolTip="最小化" Click="OnMinimizeClick">
                    <Path Style="{StaticResource CaptionIcon}" Data="M0,5 L10,5" />
                </Button>

                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}"
                        ToolTip="最大化" Click="OnMaximizeClick">
                    <Path x:Name="MaxIcon" Style="{StaticResource CaptionIcon}"
                          Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z" />
                </Button>

                <Button Style="{StaticResource CloseButton}" ToolTip="关闭" Click="OnCloseClick">
                    <Path Style="{StaticResource CaptionIcon}" Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" />
                </Button>
            </StackPanel>

            <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource LineBrush}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 视频区：mpv 直接往这里画。任何 WPF 元素都盖不住它，所以这里不放文字 -->
            <Grid x:Name="VideoHost" Grid.Column="0" Background="Black" SizeChanged="OnVideoHostSizeChanged">
                <local:VideoSurface x:Name="Surface"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />

                <!-- 图集作品：把 Surface 隐藏后用这层显示图片（HwndHost 会盖住 WPF 内容） -->
                <Grid x:Name="ImageLayer" Visibility="Collapsed" Background="Black">
                    <Image x:Name="ImageView" Stretch="Uniform" />

                    <!-- 页码放右上角，避免和图片底部的内容打架 -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,18,18,0" Panel.ZIndex="10"
                            Background="#A6000000" CornerRadius="13" Padding="12,5">
                        <TextBlock x:Name="ImageIndexText" Text="1 / 1"
                                   FontSize="12" Foreground="White" />
                    </Border>
                </Grid>
            </Grid>

            <!-- 信息栏 -->
            <Border x:Name="SidePanel" Grid.Column="1" Width="384"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                <Grid Margin="28,26,28,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Tab：详情 / 评论 -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="TabDetail" Content="详情" Tag="active"
                                    Style="{StaticResource TabButton}" Click="OnTabDetailClick" />
                            <Button x:Name="TabComments" Content="评论"
                                    Style="{StaticResource TabButton}" Click="OnTabCommentsClick" />
                        </StackPanel>
                        <TextBlock x:Name="IndexLabel" Text="" HorizontalAlignment="Right"
                                   VerticalAlignment="Top" Margin="0,2,0,0"
                                   Style="{StaticResource Caption}" />
                    </Grid>

                    <!-- 详情 -->
                    <ScrollViewer x:Name="DetailPane" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock x:Name="AuthorText" Text="正在连接…" FontSize="22"
                                       FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <TextBlock x:Name="DescText" Text="" FontSize="14" LineHeight="23"
                                       TextWrapping="Wrap" Foreground="#D6D6DE" Margin="0,0,0,18" />

                            <StackPanel x:Name="StatsPanel" Orientation="Horizontal" Margin="0,0,0,18">
                                <TextBlock x:Name="LikeText" Style="{StaticResource Stat}" />
                                <TextBlock x:Name="CommentText" Style="{StaticResource Stat}" />
                                <TextBlock x:Name="ShareText" Style="{StaticResource Stat}" />
                            </StackPanel>

                            <TextBlock x:Name="MusicText" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,0,0,4" />

                            <!-- 技术参数：来自 mpv 的实时属性，不是接口返回值 -->
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="21" />
                                    <RowDefinition Height="21" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="分辨率" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="TechRes" Grid.Row="0" Grid.Column="1" Text="—"
                                           Style="{StaticResource Caption}" Foreground="#C8C8D2" />

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="帧率" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="TechFps" Grid.Row="0" Grid.Column="3" Text="—"
                                           Style="{StaticResource Caption}" Foreground="#C8C8D2" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="解码" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="TechHwdec" Grid.Row="1" Grid.Column="1" Text="—"
                                           Style="{StaticResource Caption}" Foreground="#C8C8D2" />
                            </Grid>

                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,22,0,22" />

                            <TextBlock x:Name="TimeText" Style="{StaticResource Caption}"
                                       Text="0:00 / 0:00" Margin="0,0,0,18" />

                            <!-- 快捷键 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="↑↓ / WS" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="上一条 / 下一条" Style="{StaticResource Caption}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="空格" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="暂停 / 继续" Style="{StaticResource Caption}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="←→ / AD" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="快退快进 5 秒 / 图集翻页" Style="{StaticResource Caption}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="M" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="静音" Style="{StaticResource Caption}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="F" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="全屏（Esc 退出）" Style="{StaticResource Caption}" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="R" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="换一批推荐" Style="{StaticResource Caption}" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="L" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="登录（扫码）" Style="{StaticResource Caption}" />

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Tab" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="详情 / 评论" Style="{StaticResource Caption}" />

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="U" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="看这个作者的全部作品" Style="{StaticResource Caption}" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 评论 -->
                    <Grid x:Name="CommentsPane" Grid.Row="1" Visibility="Collapsed">
                        <ScrollViewer x:Name="CommentScroll" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      ScrollChanged="OnCommentScroll">
                            <ItemsControl x:Name="CommentList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,16">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Nickname}" FontSize="12"
                                                           Foreground="#9A9AA6" />
                                                <TextBlock Text="{Binding MetaText}" FontSize="11"
                                                           Foreground="#5A5A66" Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                       FontSize="13" LineHeight="21" Margin="0,5,0,0" />
                                            <TextBlock Text="{Binding LikeText}" FontSize="11"
                                                       Foreground="#5A5A66" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="CommentEmpty" Text="暂无评论"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Style="{StaticResource Caption}" Visibility="Collapsed" />
                    </Grid>

                    <!-- 底部：进度 + 状态 -->
                    <StackPanel Grid.Row="2" Margin="0,20,0,0">
                        <ProgressBar x:Name="Progress" Style="{StaticResource ThinProgress}"
                                     Minimum="0" Maximum="1" Value="0" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource Caption}"
                                   Text="准备中…" Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
