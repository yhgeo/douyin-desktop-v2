<Window x:Class="DouyinDesktop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DouyinDesktop.App"
        Title="抖音" Height="800" Width="1240"
        MinHeight="560" MinWidth="900"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown"
        MouseWheel="OnMouseWheel"
        Loaded="OnLoaded"
        Closing="OnClosing"
        SizeChanged="OnSizeChanged">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 视频区：mpv 直接往这里画。任何 WPF 元素都盖不住它，所以这里不放文字 -->
        <Grid x:Name="VideoHost" Grid.Column="0" Background="Black" SizeChanged="OnVideoHostSizeChanged">
            <local:VideoSurface x:Name="Surface"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
        </Grid>

        <!-- 信息栏 -->
        <Border x:Name="SidePanel" Grid.Column="1" Width="384"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
            <Grid Margin="28,30,28,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 顶部：推荐 + 序号 -->
                <DockPanel Grid.Row="0" Margin="0,0,0,22">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}"
                             VerticalAlignment="Center" DockPanel.Dock="Left" />
                    <TextBlock x:Name="TabLabel" Text="推荐" Margin="8,0,0,0"
                               FontSize="13" Foreground="{StaticResource SubTextBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="IndexLabel" Text="" HorizontalAlignment="Right"
                               Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </DockPanel>

                <!-- 内容（窗口矮时可滚动） -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="AuthorText" Text="正在连接…" FontSize="22"
                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" />

                        <TextBlock x:Name="DescText" Text="" FontSize="14" LineHeight="23"
                                   TextWrapping="Wrap" Foreground="#D6D6DE" Margin="0,0,0,18" />

                        <StackPanel x:Name="StatsPanel" Orientation="Horizontal" Margin="0,0,0,18">
                            <TextBlock x:Name="LikeText" Style="{StaticResource Stat}" />
                            <TextBlock x:Name="CommentText" Style="{StaticResource Stat}" />
                            <TextBlock x:Name="ShareText" Style="{StaticResource Stat}" />
                        </StackPanel>

                        <TextBlock x:Name="MusicText" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" Margin="0,0,0,4" />

                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,22,0,22" />

                        <TextBlock x:Name="TimeText" Style="{StaticResource Caption}"
                                   Text="0:00 / 0:00" Margin="0,0,0,18" />

                        <!-- 快捷键 -->
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26" />
                                <RowDefinition Height="26" />
                                <RowDefinition Height="26" />
                                <RowDefinition Height="26" />
                                <RowDefinition Height="26" />
                                <RowDefinition Height="26" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="↑ ↓" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="上一条 / 下一条" Style="{StaticResource Caption}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="空格" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="暂停 / 继续" Style="{StaticResource Caption}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="← →" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="快退 / 快进 5 秒" Style="{StaticResource Caption}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="M" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="静音" Style="{StaticResource Caption}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="F" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="全屏（Esc 退出）" Style="{StaticResource Caption}" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="R" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="换一批推荐" Style="{StaticResource Caption}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- 底部：进度 + 状态 -->
                <StackPanel Grid.Row="2" Margin="0,20,0,0">
                    <ProgressBar x:Name="Progress" Style="{StaticResource ThinProgress}"
                                 Minimum="0" Maximum="1" Value="0" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource Caption}"
                               Text="准备中…" Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
