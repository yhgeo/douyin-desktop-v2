<Window x:Class="DouyinDesktop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DouyinDesktop.App"
        Title="抖音" Height="800" Width="1240"
        MinHeight="560" MinWidth="900"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        InputMethod.IsInputMethodEnabled="False"
        PreviewKeyDown="OnPreviewKeyDown"
        MouseWheel="OnMouseWheel"
        Loaded="OnLoaded"
        Closing="OnClosing"
        StateChanged="OnWindowStateChanged"
        SizeChanged="OnSizeChanged">

    <!--
        无边框窗口：WindowStyle 从头到尾都是 None。
        为什么不用默认边框 + 全屏时改 WindowStyle —— 那会让 WPF 重建 HWND，
        HwndHost 重建后 mpv 嵌在旧句柄上，画面就没了，只能重启播放器（约 300ms 黑屏）。
        这里把"边框"这件事交给 WindowChrome，全屏只是隐藏标题栏 + 最大化，句柄不动。
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏 -->
        <Grid x:Name="TitleBar" Grid.Row="0" Height="38" Background="{StaticResource BgBrush}">
            <TextBlock Text="抖音" Margin="16,0,0,0" VerticalAlignment="Center"
                       FontSize="12" Foreground="{StaticResource SubTextBrush}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="设置" Width="56" Height="38"
                        Style="{StaticResource CaptionButton}"
                        FontFamily="Microsoft YaHei UI" FontSize="12"
                        ToolTip="设置快捷键与账号"
                        Click="OnSettingsClick" />

                <Button Style="{StaticResource CaptionButton}" ToolTip="最小化" Click="OnMinimizeClick">
                    <Path Style="{StaticResource CaptionIcon}" Data="M0,5 L10,5" />
                </Button>

                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}"
                        ToolTip="最大化" Click="OnMaximizeClick">
                    <Path x:Name="MaxIcon" Style="{StaticResource CaptionIcon}"
                          Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z" />
                </Button>

                <Button Style="{StaticResource CloseButton}" ToolTip="关闭" Click="OnCloseClick">
                    <Path Style="{StaticResource CaptionIcon}" Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" />
                </Button>
            </StackPanel>

            <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource LineBrush}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 视频区：mpv 直接往这里画。任何 WPF 元素都盖不住它，所以这里不放文字 -->
            <!-- 画布子窗口带 WS_EX_TRANSPARENT，点击会落到这层，用来做「点一下暂停」 -->
            <Grid x:Name="VideoHost" Grid.Column="0" Background="Black" SizeChanged="OnVideoHostSizeChanged"
                  MouseLeftButtonUp="OnVideoAreaClick">

                <!-- 底衬：视频/图片铺不满时，用同源画面做一层模糊背景（仿抖音） -->
                <Grid x:Name="BlurLayer" Background="#0B0B0E">
                    <Image x:Name="BlurImage" Stretch="UniformToFill" Opacity="0.85"
                           RenderTransformOrigin="0.5,0.5">
                        <!-- 放大一点：模糊采样到边界会发虚，放大后边缘被裁掉 -->
                        <Image.RenderTransform>
                            <ScaleTransform ScaleX="1.25" ScaleY="1.25" />
                        </Image.RenderTransform>
                        <Image.Effect>
                            <BlurEffect Radius="42" KernelType="Gaussian" RenderingBias="Performance" />
                        </Image.Effect>
                    </Image>
                    <!-- 压暗，不然亮色画面当背景会抢主体 -->
                    <Rectangle Fill="#59000000" />
                </Grid>

                <local:VideoSurface x:Name="Surface"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />

                <!-- 图集作品：把 Surface 隐藏后用这层显示图片（HwndHost 会盖住 WPF 内容） -->
                <Grid x:Name="ImageLayer" Visibility="Collapsed" Background="Transparent">
                    <Image x:Name="ImageView" Stretch="Uniform" />

                    <!-- 页码放右上角，避免和图片底部的内容打架 -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,18,18,0" Panel.ZIndex="10"
                            Background="#A6000000" CornerRadius="13" Padding="12,5">
                        <TextBlock x:Name="ImageIndexText" Text="1 / 1"
                                   FontSize="12" Foreground="White" />
                    </Border>
                </Grid>
            </Grid>

            <!-- 信息栏 -->
            <Border x:Name="SidePanel" Grid.Column="1" Width="344"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                <Grid Margin="28,26,28,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Tab：详情 / 评论 -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="TabDetail" Content="详情" Tag="active"
                                    Style="{StaticResource TabButton}" Click="OnTabDetailClick" />
                            <Button x:Name="TabComments" Content="评论"
                                    Style="{StaticResource TabButton}" Click="OnTabCommentsClick" />
                            <Button x:Name="TabProfile" Content="主页"
                                    Style="{StaticResource TabButton}" Click="OnTabProfileClick" />
                        </StackPanel>
                        <TextBlock x:Name="IndexLabel" Text="" HorizontalAlignment="Right"
                                   VerticalAlignment="Top" Margin="0,2,0,0"
                                   Style="{StaticResource Caption}" />
                    </Grid>

                    <!-- 详情 -->
                    <ScrollViewer x:Name="DetailPane" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock x:Name="AuthorText" Text="正在连接…" FontSize="22"
                                       FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />

                            <!-- IP 属地 · 发布时间 -->
                            <TextBlock x:Name="MetaLine" Style="{StaticResource Caption}"
                                       Margin="0,0,0,12" Visibility="Collapsed" />

                            <!-- 文案固定高度：太长就在框里滚，不把下面全挤走 -->
                            <ScrollViewer x:Name="DescScroll" MaxHeight="132" Margin="0,0,0,16"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="DescText" Text="" FontSize="14" LineHeight="23"
                                           TextWrapping="Wrap" Foreground="#D6D6DE" />
                            </ScrollViewer>

                            <StackPanel x:Name="StatsPanel" Orientation="Horizontal" Margin="0,0,0,18">
                                <TextBlock x:Name="LikeText" Style="{StaticResource Stat}" />
                                <TextBlock x:Name="CommentText" Style="{StaticResource Stat}" />
                                <TextBlock x:Name="ShareText" Style="{StaticResource Stat}" />
                            </StackPanel>

                            <TextBlock x:Name="MusicText" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,0,0,4" />

                            <!-- 视频技术参数（来自 mpv 实时属性） -->
                            <Grid x:Name="VideoStatsPanel" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="21" />
                                    <RowDefinition Height="21" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="分辨率" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="TechRes" Grid.Row="0" Grid.Column="1" Text="—"
                                           Style="{StaticResource Caption}" Foreground="#C8C8D2" />

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="帧率" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="TechFps" Grid.Row="0" Grid.Column="3" Text="—"
                                           Style="{StaticResource Caption}" Foreground="#C8C8D2" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="码率" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="TechBitrate" Grid.Row="1" Grid.Column="1" Text="—"
                                           Style="{StaticResource Caption}" Foreground="#C8C8D2" />
                            </Grid>

                            <!-- 图集信息（图集没有视频流，mpv 的参数不适用） -->
                            <Grid x:Name="ImageStatsPanel" Margin="0,14,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="21" />
                                    <RowDefinition Height="21" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="图片" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="ImageCountText" Grid.Row="0" Grid.Column="1" Text="—"
                                           Style="{StaticResource Caption}" Foreground="#C8C8D2" />

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="尺寸" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="ImageSizeText" Grid.Row="0" Grid.Column="3" Text="—"
                                           Style="{StaticResource Caption}" Foreground="#C8C8D2" />
                            </Grid>

                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,22,0,22" />

                            <TextBlock x:Name="TimeText" Style="{StaticResource Caption}"
                                       Text="0:00 / 0:00" Margin="0,0,0,18" />

                            <!-- 快捷键：基础键不列，取消掉的不列，整块也能手动折叠 -->
                            <TextBlock x:Name="ShortcutToggle" Text="快捷键 ▾"
                                       FontSize="12" Foreground="#7A8AA8"
                                       Margin="0,0,0,4" Cursor="Hand"
                                       MouseLeftButtonUp="OnToggleShortcuts" />

                            <ItemsControl x:Name="ShortcutList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Key}" Style="{StaticResource Caption}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Action}"
                                                       Style="{StaticResource Caption}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 评论 -->
                    <Grid x:Name="CommentsPane" Grid.Row="1" Visibility="Collapsed">
                        <ScrollViewer x:Name="CommentScroll" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      ScrollChanged="OnCommentScroll">
                            <ItemsControl x:Name="CommentList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 一条评论：左头像 + 右内容，两列对齐 -->
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 圆形头像：Border 本身不裁剪子元素，用 OpacityMask 做圆 -->
                                            <Border Grid.Column="0" Width="32" Height="32"
                                                    CornerRadius="16" Background="#24242E"
                                                    VerticalAlignment="Top">
                                                <Border.OpacityMask>
                                                    <VisualBrush>
                                                        <VisualBrush.Visual>
                                                            <Border Width="32" Height="32"
                                                                    CornerRadius="16" Background="Black" />
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Border.OpacityMask>
                                                <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <!-- 昵称 + 时间/IP 分两行，左边缘统一对齐 -->
                                                <TextBlock Text="{Binding Nickname}" FontSize="12"
                                                           Foreground="#9A9AA6"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding MetaText}" FontSize="10.5"
                                                           Foreground="#55555F" Margin="0,3,0,0" />

                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                           FontSize="13.5" LineHeight="22"
                                                           Margin="0,8,0,0" />

                                                <!-- 底部操作行：展开回复在左，点赞靠右 -->
                                                <Grid Margin="0,9,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Button Grid.Column="0" Content="{Binding ExpandText}"
                                                            Tag="{Binding}" Click="OnToggleReplies"
                                                            HorizontalAlignment="Left"
                                                            Visibility="{Binding ExpandVisibility}"
                                                            Style="{StaticResource LinkButton}" />

                                                    <TextBlock Grid.Column="1" Text="{Binding LikeText}"
                                                               FontSize="11" Foreground="#55555F"
                                                               VerticalAlignment="Center" />
                                                </Grid>

                                                <!-- 回复：缩进对齐到正文左边缘（32 头像 + 10 间距 = 42） -->
                                                <Border BorderBrush="#2A2A36" BorderThickness="2,0,0,0"
                                                        Margin="0,12,0,0" Padding="10,2,0,0"
                                                        Visibility="{Binding RepliesVisibility}">
                                                    <ItemsControl ItemsSource="{Binding Replies}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="0,0,0,12">
                                                                    <TextBlock Text="{Binding Nickname}"
                                                                               FontSize="11.5" Foreground="#8A8A98"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                                               FontSize="12.5" LineHeight="20"
                                                                               Foreground="#C8C8D4" Margin="0,5,0,0" />
                                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                        <TextBlock Text="{Binding MetaText}"
                                                                                   FontSize="10.5" Foreground="#4A4A56" />
                                                                        <TextBlock Text="{Binding LikeText}"
                                                                                   FontSize="10.5" Foreground="#4A4A56"
                                                                                   Margin="12,0,0,0" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </StackPanel>

                                            <!-- 分割线从正文左边缘开始（32 头像 + 10 间距 = 42），和头像列错开 -->
                                            <Border Grid.Row="1" Grid.ColumnSpan="2" Height="1"
                                                    Background="#16161D" Margin="42,16,0,14" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="CommentEmpty" Text="暂无评论"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Style="{StaticResource Caption}" Visibility="Collapsed" />
                    </Grid>

                    <!-- 主页：作者的视频封面墙（只加载封面图，不加载视频） -->
                    <Grid x:Name="ProfilePane" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <Image x:Name="ProfileAvatar" Width="44" Height="44"
                                   Stretch="UniformToFill" />
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ProfileName" FontSize="15"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="ProfileCount" Style="{StaticResource Caption}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <ListBox x:Name="ProfileList" Grid.Row="1" BorderThickness="0"
                                 Background="Transparent" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionChanged="OnProfileSelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,0,6,6" />
                                    <Setter Property="Padding" Value="0" />
                                    <!--
                                        这里千万别设 Focusable=False！
                                        WPF 的 ListBoxItem 是「先 Focus() 成功才改选中」，
                                        Focusable=False 会让 Focus() 返回 false，点击永远选不中，
                                        SelectionChanged 也就不触发 —— 表现就是「点封面没反应」。
                                        想要没有虚线焦点框，改模板就行，不用动 Focusable。
                                    -->
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" CornerRadius="6"
                                                        BorderThickness="2"
                                                        Background="Transparent"
                                                        BorderBrush="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush"
                                                                Value="{StaticResource AccentBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background"
                                                                Value="#1AFFFFFF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid Height="116">
                                            <Border Background="#1A1A22" CornerRadius="4" />
                                            <Image Source="{Binding Video.CoverUrl}"
                                                   Stretch="UniformToFill" />
                                            <Border VerticalAlignment="Bottom"
                                                    HorizontalAlignment="Right"
                                                    Background="#B0000000" CornerRadius="4"
                                                    Padding="4,1" Margin="4">
                                                <TextBlock Text="{Binding DurationText}"
                                                           FontSize="10" Foreground="White" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding LikeShortText}" FontSize="11"
                                                   Foreground="#7A7A88" Margin="3,4,0,2"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- 底部：进度 + 状态 -->
                    <StackPanel Grid.Row="2" Margin="0,20,0,0">
                        <ProgressBar x:Name="Progress" Style="{StaticResource ThinProgress}"
                                     Minimum="0" Maximum="1" Value="0" />
                        <DockPanel Margin="0,12,0,0">
                            <Border x:Name="ModeBadge" DockPanel.Dock="Right"
                                    Background="#1F1F28" CornerRadius="9"
                                    Padding="9,3" VerticalAlignment="Top" Margin="10,0,0,0">
                                <TextBlock x:Name="ModeLabel" Text="推荐" FontSize="11"
                                           Foreground="#A8A8B4" />
                            </Border>
                            <TextBlock x:Name="StatusText" Style="{StaticResource Caption}"
                                       Text="准备中…" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
